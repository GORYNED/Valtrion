{
  "schema": "gdv.checks/1",
  "platforms": { "required": ["ios"], "dev": ["editor"] },
  "areas": [
    { "glob": "**/*.cs", "kind": "managed" }
  ],
  "jsonRules": [
    { "glob": "Packages/packages-lock.json", "root": "dependencies", "keys": [
      { "match": "*", "kind": "managed", "byContent": { "managed": "managed", "platform": "managed", "assemblies": { "kind": "managed" } } }
    ] }
  ],
  "kinds": {
    "managed": { "L2": ["editmode:Example.Tests"] }
  },
  "unclassified": "widest"
}
