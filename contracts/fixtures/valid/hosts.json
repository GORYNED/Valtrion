{
  "schema": "gdv.hosts/1",
  "hosts": [
    {
      "id": "win-laptop",
      "transport": { "kind": "local" },
      "os": "windows",
      "roles": ["unity-editor", "android-device"],
      "capabilities": {
        "unityEditors": [ { "version": "6000.6.7f1", "modules": ["android", "windows-il2cpp"] } ],
        "buildPlatforms": ["windows", "android", "editor"],
        "adb": true
      },
      "projectsRoot": "D:/Projects",
      "worktreePolicy": "per-task",
      "artifactsRoot": "D:/gdv-artifacts"
    },
    {
      "id": "mac-build",
      "transport": { "kind": "ssh", "sshTarget": "builder@mac-build.example", "connectTimeoutSec": 10 },
      "os": "macos",
      "roles": ["ios-build", "ios-device"],
      "capabilities": {
        "unityEditors": [ { "version": "6000.6.7f1", "modules": ["ios", "mac-il2cpp"] } ],
        "buildPlatforms": ["ios", "macos", "editor"],
        "xcode": "27.1",
        "iosSigning": true
      },
      "projectsRoot": "~/Documents/Projects",
      "worktreePolicy": "per-task",
      "artifactsRoot": "~/Documents/Projects/gdv-artifacts"
    }
  ]
}
