{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gdv.checks/1",
  "title": "Project check map: changed paths to kinds, kinds to checks per level",
  "type": "object",
  "required": ["schema", "platforms", "unclassified"],
  "anyOf": [{ "required": ["areas", "kinds"] }, { "required": ["extends"] }],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "gdv.checks/1" },
    "platforms": {
      "type": "object",
      "required": ["required"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/platform" } },
        "dev": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/platform" } }
      }
    },
    "unityEditorSlots": { "$ref": "common.schema.json#/$defs/int32", "minimum": 1 },
    "extends": { "type": "string", "pattern": "^valtrion:[a-z0-9-]+/[0-9]+$" },
    "bindings": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1 } }
    },
    "runners": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["glob", "kind"],
        "additionalProperties": false,
        "properties": {
          "glob": { "type": "string", "minLength": 1 },
          "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "kind": { "$ref": "common.schema.json#/$defs/identifier" },
          "overridesPreset": { "type": "boolean" }
        }
      }
    },
    "jsonRules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["glob", "root", "keys"],
        "additionalProperties": false,
        "properties": {
          "glob": { "type": "string", "minLength": 1 },
          "root": { "type": "string", "minLength": 1 },
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["match"],
              "anyOf": [{ "required": ["kind"] }, { "required": ["kinds"] }],
              "additionalProperties": false,
              "properties": {
                "match": { "type": "string", "minLength": 1 },
                "kind": { "$ref": "common.schema.json#/$defs/identifier" },
                "kinds": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/identifier" } },
                "allowHeavyFallback": { "type": "boolean" },
                "byContent": {
                  "type": "object",
                  "required": ["managed", "platform"],
                  "additionalProperties": false,
                  "properties": {
                    "managed": { "$ref": "common.schema.json#/$defs/identifier" },
                    "platform": { "$ref": "common.schema.json#/$defs/identifier" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "contentRules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["glob", "kind", "lineComment"],
        "additionalProperties": false,
        "properties": {
          "glob": { "type": "string", "minLength": 1 },
          "kind": { "$ref": "common.schema.json#/$defs/identifier" },
          "lineComment": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "reindent": { "type": "boolean" },
          "codePrefixes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "blockComment": {
            "type": "object",
            "required": ["start", "end"],
            "additionalProperties": false,
            "properties": {
              "start": { "type": "string", "minLength": 1 },
              "end": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "equivalenceRules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["glob", "kind", "command"],
        "additionalProperties": false,
        "properties": {
          "glob": { "type": "string", "minLength": 1 },
          "kind": { "$ref": "common.schema.json#/$defs/identifier" },
          "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "timeoutSec": { "$ref": "common.schema.json#/$defs/int32", "minimum": 1, "maximum": 3600 }
        }
      }
    },
    "kinds": { "type": "object", "additionalProperties": { "$ref": "#/$defs/levels" } },
    "unclassified": { "enum": ["widest", "fail"] }
  },
  "$defs": {
    "levels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "L0": { "$ref": "common.schema.json#/$defs/stringList" },
        "L1": { "$ref": "common.schema.json#/$defs/stringList" },
        "L2": { "$ref": "common.schema.json#/$defs/stringList" },
        "L3": { "$ref": "common.schema.json#/$defs/stringList" },
        "L4": { "$ref": "common.schema.json#/$defs/stringList" }
      }
    }
  }
}
