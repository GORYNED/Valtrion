{
  "schema": "gdv.checks/1",
  "platforms": { "required": ["ios"], "dev": ["windows", "editor"] },
  "unityEditorSlots": 1,
  "runners": {
    "unity-editmode": "valtrion unity run -- -batchmode -projectPath . -runTests -testPlatform EditMode -assemblyNames {assemblies;} -testResults Builds/editmode.xml -logFile Builds/editmode.log"
  },
  "areas": [
    { "glob": "Assets/Project/Runtime/**", "kind": "runtime" },
    { "glob": "Assets/Project/Playback/**", "kind": "playback-perf" },
    { "glob": "docs/**", "kind": "docs" },
    { "glob": "validation/**", "kind": "docs" }
  ],
  "kinds": {
    "runtime": {
      "L0": ["l0"],
      "L2": ["editmode:Project.Runtime.Tests@unity-editmode"],
      "L3": ["player:ios"]
    },
    "playback-perf": {
      "L0": ["l0"],
      "L2": ["editmode:Project.Playback.Tests@unity-editmode"],
      "L4": ["device:plans/perf.open-playback"]
    },
    "docs": { "L0": ["l0"] }
  },
  "unclassified": "widest"
}
